APP_NAME=SaaSykit
APP_DESCRIPTION="SaaSykit is a SaaS starter kit that helps you build and launch your SaaS product faster."
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
# Der Funnel Builder ist ein deutschsprachiges Produkt (lang/de/*.php).
APP_LOCALE=de

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=4320

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Betreiberadresse fuer interne Meldungen (Auszahlungen, Saldenabweichung,
# fehlgeschlagene Abrechnung). Ohne Wert gilt MAIL_FROM_ADDRESS.
SUPPORT_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

PAYMENT_PRORATION_ENABLED=true

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SIGNING_SECRET=""

PADDLE_VENDOR_ID=""
PADDLE_CLIENT_SIDE_TOKEN=""
PADDLE_VENDOR_AUTH_CODE=""
PADDLE_PUBLIC_KEY=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_IS_SANDBOX=true

LEMON_SQUEEZY_API_KEY=""
LEMON_SQUEEZY_STORE_ID=""
LEMON_SQUEEZY_SIGNING_SECRET=""
LEMON_SQUEEZY_IS_TEST_MODE=false

GOOGLE_TRACKING_ID="G-XXXXX"
TRACKING_SCRIPTS=""

SOCIAL_FACEBOOK_URL=""
SOCIAL_X_URL=""
SOCIAL_INSTAGRAM_URL=""
SOCIAL_LINKEDIN_URL=""
SOCIAL_YOUTUBE_URL=""
SOCIAL_GITHUB_URL=""
SOCIAL_DISCORD_URL=""

RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_SKIP_IP=""

COOKIE_CONSENT_ENABLED=false

TWILIO_SID=""
TWILIO_TOKEN=""
TWILIO_FROM=""

TRIAL_WITHOUT_PAYMENT_SMS_VERIFICATION_ENABLED=false

###############################################################################
# Funnel Builder (siehe config/funnel.php)
###############################################################################

# FB-001: Mitgelieferte SaaSykit-Module. Default aus - weder Routen noch
# Navigationseintraege werden registriert, solange das Flag nicht gesetzt ist.
FUNNEL_FEATURE_BLOG_ENABLED=false
FUNNEL_FEATURE_ROADMAP_ENABLED=false
FUNNEL_FEATURE_ANNOUNCEMENTS_ENABLED=false
FUNNEL_FEATURE_REFERRAL_ENABLED=false

# FB-003: Datenvernichtende Artisan-Befehle (migrate:fresh, migrate:refresh,
# migrate:reset, db:wipe) sind in JEDER Umgebung gesperrt - auch mit --force.
# Nur die Testsuite darf sie ausfuehren: APP_ENV=testing UND FUNNEL_ALLOW_DESTRUCTIVE=1.
# Niemals ausserhalb der Testumgebung auf 1 setzen.
FUNNEL_ALLOW_DESTRUCTIVE=0

# FB-006: Tenant-API-Tokens. 0 Tage = kein Ablauf.
FUNNEL_API_TOKEN_EXPIRATION_DAYS=0
FUNNEL_API_MAX_TOKENS_PER_TENANT=10

# FB-004: Lead-Schwellwerte
FUNNEL_LEAD_DEFAULT_PRICE=15.00
FUNNEL_LEAD_RESERVATION_TTL=10
FUNNEL_LEAD_RETENTION_DAYS=730
FUNNEL_LEAD_STALE_AFTER_DAYS=3

# FB-004: Oeffentliche Funnel-Endpunkte
FUNNEL_PUBLIC_RATE_LIMIT_PER_HOUR=20
FUNNEL_PUBLIC_MIN_SECONDS_BEFORE_SUBMIT=30

# FB-004: Telefonische Kontaktaufnahme durch den Kaeufer
FUNNEL_CALL_ANSWERED_AFTER_SECONDS=30
FUNNEL_CALL_MAX_FAILED_ATTEMPTS=3
FUNNEL_CALL_MIN_GAP_HOURS=2
FUNNEL_CALL_MIN_DAYS=2
FUNNEL_CALL_DEADLINE_DAYS=7

# local development settings

APP_PORT=8080
FORWARD_DB_PORT=3306
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
FORWARD_REDIS_PORT=6379
VITE_PORT=5173
FORWARD_NGROK_PORT=4040

SAIL_XDEBUG_MODE=develop,debug,coverage

NGROK_AUTHTOKEN=
NGROK_STATIC_DOMAIN=

###############################################################################
# Erreichbarkeitspruefung per Click-to-Call (siehe config/twilio.php und
# config/lead_calls.php)
###############################################################################

# FB-082: Twilio-Zugangsdaten und Portal-Nummer. TWILIO_SID/TWILIO_TOKEN/
# TWILIO_FROM stehen weiter oben in dieser Datei und werden von config/twilio.php
# mitgenutzt - TWILIO_FROM ist die Portal-Nummer in E.164 (z. B. "+4930123456").

# FB-084: Die Signaturpruefung der Twilio-Rueckrufe rechnet mit genau der URL,
# die Twilio angerufen hat. Hinter Reverse Proxy oder Load Balancer muss deshalb
# das https-Schema durchgereicht und der Proxy vertraut werden - sonst sieht
# Laravel http und jede Pruefung schlaegt fehl. Kommaseparierte IPs oder "*";
# leer heisst: keinem Proxy vertrauen. APP_URL muss auf die oeffentliche Adresse
# zeigen, lokal also auf die ngrok-URL.
TRUSTED_PROXIES=

# FB-082: Schwellwerte des Regelwerks. Alle Werte sind optional, die Defaults
# stehen in config/lead_calls.php.
LEAD_CALLS_ANSWERED_MIN_SECONDS=30
LEAD_CALLS_RETRY_MIN_HOURS=2
LEAD_CALLS_UNREACHABLE_ATTEMPTS=3
LEAD_CALLS_UNREACHABLE_MIN_DAYS=2
LEAD_CALLS_DEADLINE_DAYS=7
LEAD_CALLS_BUYER_RING_TIMEOUT=25
LEAD_CALLS_LEAD_RING_TIMEOUT=30
LEAD_CALLS_UNREACHABLE_RATE_FLAG_POINTS=20
LEAD_CALLS_MACHINE_DETECTION="DetectMessageEnd"

# Cutover fuer Bestandsleads: Nur Leads mit delivered_at ab diesem Zeitpunkt
# unterliegen dem Regelwerk. Leer = alle Leads.
LEAD_CALLS_ENFORCE_FROM=""

###############################################################################
# Geldbasiertes Wallet (siehe config/wallet.php)
###############################################################################

# LP-WALLET: Provision der Plattform je verkauftem Lead, in Prozent des
# Kaufpreises. Der Rest ist die Einnahme des Verkaeufers. Alle uebrigen
# Wallet-Werte (WALLET_CURRENCY, WALLET_TOPUP_MIN_CENTS,
# WALLET_TOPUP_MAX_CENTS, WALLET_TOPUP_PRODUCT_SLUG, WALLET_PAYOUT_MIN_CENTS,
# WALLET_LEGACY_CREDIT_VALUE_CENTS, WALLET_PLATFORM_OWNER) haben brauchbare
# Defaults in config/wallet.php.
WALLET_COMMISSION_PERCENT=20

# LP-WALLET: Preis (Cent), zu dem ein neu angelegter Verkaeufer seine Leads
# anbietet, solange er keinen eigenen Preis gesetzt hat.
WALLET_DEFAULT_LEAD_PRICE_CENTS=1500

# LP-WALLET: Spanne (Cent), in der ein Verkaeufer seinen Leadpreis selbst
# setzen darf.
WALLET_LEAD_PRICE_MIN_CENTS=100
WALLET_LEAD_PRICE_MAX_CENTS=50000

###############################################################################
# Pay as you go / Postpaid (siehe config/wallet.php, Abschnitt postpaid)
###############################################################################

# LP-POSTPAID: Hauptschalter des Rollouts. false schaltet Antrag, Aufschlag am
# Marktplatz und den automatischen Einzug ab, ohne bereits freigeschaltete
# Kaeufer zurueckzustufen.
WALLET_POSTPAID_ENABLED=false

# LP-POSTPAID: Aufschlag (Prozent des Leadpreises) auf jeden Postpaid-Kauf.
WALLET_POSTPAID_SURCHARGE_PERCENT=7.5

# LP-POSTPAID: Kreditrahmen (Cent) eines frisch freigeschalteten Kaeufers.
# Alle uebrigen Postpaid-Werte (Einzugsschwelle, Einzugstermin, Wartezeit vor
# dem zweiten Versuch, Mahn- und Ruecklastschriftgebuehr, Eignungshuerden)
# haben brauchbare Defaults in config/wallet.php.
WALLET_POSTPAID_CREDIT_LIMIT_CENTS=30000

# LP-POSTPAID: Glaeubiger des SEPA-Lastschriftmandats, wie er im Mandatstext
# und auf dem Kontoauszug des Kaeufers steht.
WALLET_POSTPAID_CREDITOR_NAME=

# LP-POSTPAID: Eigene Glaeubiger-Identifikationsnummer, falls bei der
# Bundesbank beantragt. Leer lassen ist der Regelfall: Stripe tritt als
# Zahlungsdienstleister mit eigener Kennung auf, im Mandatstext steht dann
# deren Nummer.
WALLET_POSTPAID_CREDITOR_ID=

# LP-POSTPAID: Signatur-Secret des zweiten Stripe-Webhooks (Zahlungsmittel,
# Mandate, Einzuege). Leer lassen, wenn beide Ereignismengen auf demselben
# Endpunkt eingerichtet sind -- dann gilt STRIPE_WEBHOOK_SIGNING_SECRET.
WALLET_POSTPAID_WEBHOOK_SIGNING_SECRET=
